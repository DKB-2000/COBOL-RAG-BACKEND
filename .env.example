# Paths are resolved from the process working directory.
LEGACY_RAG_DATA_ROOT=./data
LEGACY_RAG_CHROMA_PATH=./data/chroma/api-v3-identifier-aware
LEGACY_RAG_RETRIEVAL_PROFILE=identifier-aware
LEGACY_RAG_RERANKING=bge-int8
LEGACY_RAG_RERANKER_MODEL_DIR=./data/models/models--BAAI--bge-reranker-v2-m3/snapshots/953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
LEGACY_RAG_MODEL_DIR=./data/models/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2/snapshots/e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Generation stays disabled until explicitly enabled in the process environment.
LEGACY_RAG_GENERATION_PROVIDER=disabled
OPENAI_API_KEY=
LEGACY_RAG_OPENAI_MODEL=gpt-6-luna
LEGACY_RAG_OPENAI_TIMEOUT_SECONDS=30
LEGACY_RAG_OPENAI_MAX_OUTPUT_TOKENS=1000
# Local generation: set LEGACY_RAG_GENERATION_PROVIDER=ollama and install qwen3:4b first.
# Ollama endpoint is fixed to http://127.0.0.1:11434; OLLAMA_HOST is not used.
LEGACY_RAG_OLLAMA_TIMEOUT_SECONDS=300
LEGACY_RAG_OLLAMA_MAX_OUTPUT_TOKENS=1024
# When enabling OpenAI, use ./data/chroma/openai-public-identifier-v1.
# This file is an example only; the app does not automatically load .env files.
